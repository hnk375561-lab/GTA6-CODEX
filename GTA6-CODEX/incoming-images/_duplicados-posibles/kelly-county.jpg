    <body class="font-sans antialiased bg-[#0a0015] text-white min-h-screen" style="overflow-x:hidden;max-width:100vw;">

        

        <style>
    body.mobile-menu-open { overflow:hidden!important; position:fixed!important; width:100%!important; height:100%!important; }
    body.search-open { overflow:hidden!important; }

    /* Reset all search inputs — prevent Tailwind/browser defaults */
    .gta-search-bar input,
    .gta-msearch-top input,
    .gta-search-bar input[type="search"],
    .gta-msearch-top input[type="search"],
    .gta-search-bar input:focus,
    .gta-msearch-top input:focus,
    .gta-search-bar input[type="search"]:focus,
    .gta-msearch-top input[type="search"]:focus {
        background: transparent !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        -webkit-appearance: none !important;
        appearance: none !important;
        padding: 0 !important;
        margin: 0 !important;
        font-size: inherit !important;
        line-height: inherit !important;
        height: auto !important;
        width: 100% !important;
        border-radius: 0 !important;
        --tw-ring-shadow: none !important;
        --tw-ring-color: transparent !important;
    }

    /* ═══ HEADER BAR ═══ */
    .gta-header {
        position: sticky;
        top: 0;
        z-index: 9999;
        width: 100%;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        background: rgba(10, 10, 20, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255, 20, 80, 0.1);
        box-sizing: border-box;
    }
    @media (min-width: 1024px) {
        .gta-header { height: 66px; padding: 0 32px; }
    }

    /* ═══ LOGO ═══ */
    .gta-logo {
        display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0;
        position: absolute; left: 50%; transform: translateX(-50%);
        transition: filter 0.2s ease;
    }
    .gta-logo:hover { filter: brightness(1.15); }
    @media (min-width: 1024px) {
        .gta-logo { position: relative; left: auto; transform: none; }
    }
    .gta-logo img { height: 40px; width: auto; image-rendering: auto; }
    @media (min-width: 1024px) {
        .gta-logo img { height: 52px; }
    }

    /* ═══ TEXT LOGO ═══ */
    .gta-text-logo {
        display: inline-flex; align-items: baseline; user-select: none; white-space: nowrap; line-height: 1;
    }
    .gta-text-logo-gta, .gta-text-logo-intel {
        font-family: 'Pricedown', Impact, sans-serif; color: rgba(255,255,255,0.9); text-transform: uppercase;
        letter-spacing: 0px; font-size: 26px;
    }
    .gta-text-logo-six {
        font-family: 'Pricedown', Impact, sans-serif; line-height: 1;
        color: rgba(232,68,106,0.9); -webkit-text-fill-color: rgba(232,68,106,0.9);
        display: inline-block; transform: scaleX(1.15);
        font-size: 28px; margin: 0 2px; position: relative; top: 0.5px;
    }
    @media (min-width: 1024px) {
        .gta-text-logo-gta, .gta-text-logo-intel { font-size: 30px; }
        .gta-text-logo-six { font-size: 33px; margin: 0 2px; }
    }

    .gta-logo-badge {
        display: none;
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: rgba(255, 45, 120, 0.9);
        background: rgba(255, 45, 120, 0.12);
        border: 1px solid rgba(255, 45, 120, 0.35);
        border-radius: 4px;
        padding: 2px 8px;
        line-height: 1.4;
        white-space: nowrap;
    }
    @media (min-width: 1024px) {
        .gta-logo-badge { display: inline-flex; }
    }

    /* ═══ DESKTOP NAV ═══ */
    .gta-nav { display: none; align-items: center; gap: 2px; }
    @media (min-width: 1024px) {
        .gta-nav {
            display: flex;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }
    }

    .gta-nav-link {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
        padding: 8px 14px;
        position: relative;
        transition: color 0.25s ease;
        white-space: nowrap;
    }
    .gta-nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 14px;
        right: 14px;
        height: 2px;
        background: #ff1450;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s ease;
        border-radius: 1px;
    }
    .gta-nav-link:hover { color: #fff; }
    .gta-nav-link:hover::after { transform: scaleX(1); }
    .gta-nav-link[aria-current="page"] { color: #fff; }
    .gta-nav-link[aria-current="page"]::after { transform: scaleX(1); }

    /* ═══ DROPDOWN ═══ */
    .gta-dropdown { position: relative; }
    .gta-dropdown-btn {
        display: flex; align-items: center; gap: 3px;
        cursor: pointer; background: none; border: none;
    }
    .gta-dropdown-btn svg { width: 10px; height: 10px; color: rgba(255, 255, 255, 0.25); transition: color 0.2s, transform 0.2s; }
    .gta-dropdown:hover .gta-dropdown-btn svg,
    .gta-dropdown:focus-within .gta-dropdown-btn svg { color: rgba(255, 255, 255, 0.5); transform: rotate(180deg); }

    .gta-dropdown-menu {
        position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
        padding-top: 10px; z-index: 9999;
        pointer-events: none;
        opacity: 0;
    }
    .gta-dropdown-menu-inner-wrap {
        transform: translateY(-4px);
        transition: opacity 0.15s ease, transform 0.15s ease;
        opacity: 0;
    }
    .gta-dropdown:hover .gta-dropdown-menu,
    .gta-dropdown:focus-within .gta-dropdown-menu {
        pointer-events: auto;
        opacity: 1;
    }
    .gta-dropdown:hover .gta-dropdown-menu-inner-wrap,
    .gta-dropdown:focus-within .gta-dropdown-menu-inner-wrap {
        opacity: 1;
        transform: translateY(0);
    }

    .gta-dropdown-inner {
        width: 460px;
        background: #0d0f15;
        border: 1px solid #2a2d36;
        border-radius: 12px; padding: 8px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6), 0 2px 8px rgba(0, 0, 0, 0.4);
        position: relative; z-index: 100;
    }
    .gta-dropdown-list { display: flex; flex-direction: column; gap: 2px; }
    .gta-dropdown-list--grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
    }
    .gta-dropdown-item {
        display: flex; align-items: center; gap: 10px; padding: 8px 10px;
        border-radius: 8px; text-decoration: none; cursor: pointer;
        background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.04);
        transition: background 0.15s, transform 0.15s, box-shadow 0.15s, border-color 0.15s;
    }
    .gta-dropdown-item:hover {
        background: rgba(255, 45, 120, 0.1);
        border-color: rgba(255, 20, 80, 0.15);
        transform: translateX(2px);
        box-shadow: inset 2px 0 0 #ff1450;
    }
    .gta-dropdown-item-name {
        font-family: 'Barlow Condensed', sans-serif; font-size: 13px; font-weight: 600;
        color: rgba(255, 255, 255, 0.7); letter-spacing: 0.3px; text-transform: uppercase;
        transition: color 0.15s; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .gta-dropdown-item:hover .gta-dropdown-item-name { color: #fff; }
    .gta-dropdown-item-count {
        font-family: 'Barlow', sans-serif; font-size: 11px; color: rgba(255, 255, 255, 0.25);
        flex-shrink: 0; transition: color 0.15s;
    }
    .gta-dropdown-item:hover .gta-dropdown-item-count { color: rgba(255, 20, 80, 0.5); }
    .gta-dropdown-item-arrow {
        width: 14px; height: 14px; color: rgba(255, 255, 255, 0.15); flex-shrink: 0; transition: color 0.15s, transform 0.15s;
    }
    .gta-dropdown-item:hover .gta-dropdown-item-arrow { color: #ff1450; transform: translateX(2px); }
    .gta-dropdown-inner--narrow { width: 280px; }
    .gta-dropdown-inner--narrow .gta-dropdown-item { gap: 12px; }
    .gta-dropdown-media-icon {
        width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .gta-dropdown-media-icon svg { width: 20px; height: 20px; }
    .gta-dropdown-item-icon {
        width: 40px; height: 40px; border-radius: 8px;
        background: rgba(255, 20, 80, 0.06); border: 1px solid rgba(255, 20, 80, 0.1);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .gta-dropdown-item-icon svg { width: 20px; height: 20px; color: #ff1450; }
    .gta-dropdown-item:hover .gta-dropdown-item-icon { background: rgba(255, 20, 80, 0.1); border-color: rgba(255, 20, 80, 0.2); }

    /* ═══ RIGHT ACTIONS ═══ */
    .gta-header-actions { display: flex; align-items: center; gap: 4px; position: relative; }

    /* Icon buttons */
    .gta-icon-btn {
        display: flex; align-items: center; justify-content: center;
        width: 40px; height: 40px; border-radius: 8px; border: none; background: none;
        color: rgba(255, 255, 255, 0.6); cursor: pointer; transition: background 0.15s, color 0.15s;
    }
    .gta-icon-btn:hover { background: rgba(255, 255, 255, 0.08); color: #fff; }
    .gta-icon-btn svg { width: 20px; height: 20px; }
    .gta-hamburger { display: flex; }
    @media (min-width: 1024px) { .gta-hamburger { display: none; } }

    /* ═══ DESKTOP SEARCH — inline in navbar ═══ */
    .gta-search-wrap {
        display: none;
        position: relative;
    }
    @media (min-width: 1024px) { .gta-search-wrap { display: flex; align-items: center; } }

    /* Trigger pill — visible search bar */
    .gta-search-trigger {
        display: flex; align-items: center; gap: 10px;
        padding: 9px 18px;
        background: rgba(255, 20, 80, 0.03);
        border: 1px solid rgba(255, 20, 80, 0.15);
        border-radius: 10px; cursor: pointer;
        transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
        animation: search-shimmer 3s ease-in-out 1s infinite;
    }
    @keyframes search-shimmer {
        0%, 100% { border-color: rgba(255, 20, 80, 0.15); box-shadow: none; }
        50% { border-color: rgba(255, 20, 80, 0.35); box-shadow: 0 0 10px rgba(255, 20, 80, 0.1); }
    }
    .gta-search-trigger:hover { border-color: rgba(255, 20, 80, 0.5); background: rgba(255, 20, 80, 0.1); box-shadow: 0 0 20px rgba(255, 20, 80, 0.15); animation: none; }
    .gta-search-trigger svg { width: 16px; height: 16px; color: #ff1450; flex-shrink: 0; }
    .gta-search-trigger-text { font-family: 'Barlow', sans-serif; font-size: 13px; font-weight: 500; letter-spacing: 0.3px; color: rgba(255, 255, 255, 0.55); white-space: nowrap; }

    /* ═══ DESKTOP SEARCH — dropdown from header ═══ */
    .gta-search-expanded {
        display: none;
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 8px;
        width: 580px;
        z-index: 10001;
    }
    .gta-search-expanded.active { display: block; }


    .gta-search-bar {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 18px;
        background: rgb(20, 5, 32);
        border: 2px solid rgba(227, 0, 127, 0.4);
        border-bottom: 1px solid rgba(227, 0, 127, 0.15);
        border-radius: 16px 16px 0 0;
        box-shadow: 0 0 20px rgba(227, 0, 127, 0.15);
    }
    .gta-search-bar svg.gs-icon { width: 18px; height: 18px; color: rgba(255, 255, 255, 0.3); flex-shrink: 0; transition: color 0.15s; }
    .gta-search-bar:focus-within svg.gs-icon { color: #ff1450; }

    .gta-search-input {
        flex: 1; background: transparent !important; border: none !important; outline: none !important;
        box-shadow: none !important; -webkit-appearance: none; appearance: none;
        font-family: 'Barlow', sans-serif; font-size: 15px; color: #fff; caret-color: #ff1450;
        min-width: 0; padding: 0; margin: 0; border-radius: 0;
    }
    .gta-search-input::placeholder { color: rgba(255, 255, 255, 0.3); }
    .gta-search-input:focus { background: transparent !important; border: none !important; outline: none !important; box-shadow: none !important; ring: none; }

    .gta-search-esc {
        background: rgba(255, 255, 255, 0.08); border: none; border-radius: 4px;
        padding: 3px 7px; font-family: 'Barlow', sans-serif; font-size: 10px;
        color: rgba(255, 255, 255, 0.3); cursor: pointer; transition: all 0.15s; flex-shrink: 0;
    }
    .gta-search-esc:hover { background: rgba(255, 255, 255, 0.15); color: #fff; }

    .gta-search-spinner {
        display: none; width: 16px; height: 16px; flex-shrink: 0;
        border: 2px solid rgba(255, 20, 80, 0.2); border-top-color: #ff1450;
        border-radius: 50%; animation: gta-spin 0.8s linear infinite;
    }
    .gta-search-spinner.active { display: block; }

    .gta-search-dropdown {
        background: rgb(20, 5, 32);
        border: 2px solid rgba(227, 0, 127, 0.4);
        border-top: none;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(227, 0, 127, 0.1);
        max-height: min(480px, calc(100vh - 160px));
        overflow-y: auto;
        transform-origin: top center;
        animation: gsDropdownOpen 150ms cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    @keyframes gsDropdownOpen {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .gta-search-dropdown::-webkit-scrollbar { width: 3px; }
    .gta-search-dropdown::-webkit-scrollbar-track { background: transparent; }
    .gta-search-dropdown::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.08); border-radius: 3px; }
    .gta-search-dropdown::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.15); }
    .gta-search-dropdown { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.08) transparent; }

    /* ═══ MOBILE SEARCH — fullscreen overlay ═══ */
    .gta-msearch-overlay {
        display: none; position: fixed; inset: 0; z-index: 99999;
        background: rgba(13, 11, 26, 0.98);
        flex-direction: column;
    }
    .gta-msearch-overlay.active { display: flex; }

    .gta-msearch-top {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 16px; border-bottom: 2px solid rgba(227, 0, 127, 0.25);
        flex-shrink: 0;
    }
    .gta-msearch-top svg.gs-icon { width: 20px; height: 20px; color: rgba(255, 255, 255, 0.3); flex-shrink: 0; transition: color 0.15s; }
    .gta-msearch-top:focus-within svg.gs-icon { color: #ff1450; }

    .gta-msearch-input {
        flex: 1; background: transparent !important; border: none !important; outline: none !important;
        box-shadow: none !important; -webkit-appearance: none; appearance: none;
        font-family: 'Barlow', sans-serif; font-size: 16px; color: #fff; caret-color: #ff1450;
        min-width: 0; padding: 0; margin: 0; border-radius: 0;
    }
    .gta-msearch-input::placeholder { color: rgba(255, 255, 255, 0.3); }
    .gta-msearch-input:focus { background: transparent !important; border: none !important; outline: none !important; box-shadow: none !important; }

    .gta-msearch-close {
        width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.08); border: none; border-radius: 8px;
        color: #c4b8d6; cursor: pointer; flex-shrink: 0; transition: background 0.15s;
    }
    .gta-msearch-close:hover { background: rgba(255, 255, 255, 0.15); }
    .gta-msearch-close svg { width: 18px; height: 18px; }

    .gta-msearch-spinner {
        display: none; width: 16px; height: 16px; flex-shrink: 0;
        border: 2px solid rgba(255, 20, 80, 0.2); border-top-color: #ff1450;
        border-radius: 50%; animation: gta-spin 0.8s linear infinite;
    }
    .gta-msearch-spinner.active { display: block; }

    .gta-msearch-body {
        flex: 1; overflow-y: auto; padding: 0;
    }

    /* Section titles */
    .gs-section-title {
        font-family: 'Barlow Condensed', sans-serif; font-size: 10px; font-weight: 700;
        letter-spacing: 1.5px; text-transform: uppercase; color: #6b5d80;
        padding: 14px 16px 8px;
    }

    /* Category browse list — vertical */
    .gs-cat-list { padding: 4px 8px 8px; }
    .gs-cat-header {
        display: flex; align-items: center; gap: 10px;
        padding: 8px 10px; border-radius: 8px;
        text-decoration: none; transition: background 0.15s ease;
    }
    .gs-cat-header:hover { background: rgba(255, 20, 80, 0.06); }
    .gs-cat-header:active { background: rgba(255, 20, 80, 0.1); }
    .gs-cat-header-info { flex: 1; min-width: 0; }
    .gs-cat-header-name {
        font-family: 'Barlow Condensed', sans-serif; font-size: 13px; font-weight: 600;
        letter-spacing: 0.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.5);
        transition: color 0.15s;
    }
    .gs-cat-header:hover .gs-cat-header-name { color: #fff; }
    .gs-cat-header-count {
        font-family: 'Barlow', sans-serif; font-size: 11px; color: #4a3d60;
    }
    .gs-cat-header-arrow {
        width: 16px; height: 16px; color: #4a3d60; flex-shrink: 0; transition: color 0.15s;
    }
    .gs-cat-header:hover .gs-cat-header-arrow { color: #ff1450; }
    .gs-cat-header:active .gs-cat-header-arrow { color: #ff1450; }

    /* Recent searches */
    .gs-recent-item {
        display: flex; align-items: center; gap: 10px;
        padding: 8px 16px; cursor: pointer; transition: background 0.15s;
        font-family: 'Barlow', sans-serif; font-size: 13px; color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
    }
    .gs-recent-item:hover { background: rgba(255, 255, 255, 0.04); color: #fff; }
    .gs-recent-item svg { width: 14px; height: 14px; color: #4a3d60; flex-shrink: 0; }
    .gs-recent-clear {
        font-family: 'Barlow', sans-serif; font-size: 11px; color: #4a3d60;
        background: none; border: none; cursor: pointer; padding: 0; margin-left: auto;
        transition: color 0.15s;
    }
    .gs-recent-clear:hover { color: #ff1450; }
    .gs-recent-header { display: flex; align-items: center; padding: 14px 16px 8px; }
    .gs-recent-header .gs-section-title { padding: 0; flex: 1; }

    .gs-divider { height: 1px; background: rgba(255, 255, 255, 0.05); margin: 0 16px; }

    /* Live results — shared between desktop + mobile */
    .gs-results { padding: 0; }
    .gs-results .gta-search-results {
        position: relative !important; top: auto !important; left: auto !important;
        transform: none !important; width: 100% !important; max-width: 100% !important;
        border: none !important; box-shadow: none !important; background: transparent !important; border-radius: 0 !important;
    }
    .gs-results .gta-search-results-inner { padding: 8px !important; }
    .gs-results .gta-search-category-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 12px 4px;
    }
    .gs-results .gta-search-category-name {
        font-family: 'Barlow Condensed', sans-serif !important; font-size: 10px !important;
        font-weight: 700 !important; letter-spacing: 1.5px !important;
        color: #6b5d80 !important; text-transform: uppercase !important;
    }
    .gs-results .gta-search-category-count {
        font-family: 'Barlow', sans-serif; font-size: 11px; color: #4a3d60;
        text-decoration: none; transition: color 0.15s;
    }
    .gs-results .gta-search-category-count:hover { color: #ff1450; }
    .gs-results .gta-search-item {
        display: flex; align-items: center; gap: 10px;
        padding: 8px 12px; min-height: 44px; border-radius: 8px;
        text-decoration: none; transition: background 0.15s;
    }
    .gs-results .gta-search-item:hover { background: rgba(255, 45, 120, 0.08); }
    .gs-results .gta-search-item--disabled { opacity: 0.5; }
    .gs-results .gta-search-item-image { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; background: #1a1030; flex-shrink: 0; }
    .gs-results .gta-search-item-info { flex: 1; min-width: 0; }
    .gs-results .gta-search-item-name {
        font-family: 'Barlow', sans-serif; font-size: 14px; font-weight: 500; color: #fff;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;
    }
    .gs-results .gta-search-item-name.disabled { color: #4a3d60; }
    .gs-results .gta-search-item-cat {
        font-family: 'Barlow', sans-serif; font-size: 11px; color: #6b5d80;
    }
    .gs-results .gta-search-item-badges { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
    .gs-results .gta-badge-coming-soon {
        font-family: 'Barlow', sans-serif; font-size: 9px; font-weight: 700;
        color: #4a3d60; background: rgba(255,255,255,0.05); padding: 2px 6px; border-radius: 4px;
        text-transform: uppercase; letter-spacing: 0.5px;
    }
    .gs-results .gta-search-view-all {
        display: block; padding: 6px 12px 10px; text-decoration: none;
        font-family: 'Barlow', sans-serif; font-size: 12px; font-weight: 500; color: #ff1450;
        transition: color 0.15s;
    }
    .gs-results .gta-search-view-all:hover { color: #ff5c8a; }
    .gs-results .gta-search-view-all span { font-size: 14px; }
    .gs-results .gta-search-divider { height: 1px; background: rgba(255, 45, 120, 0.06); margin: 4px 8px; }
    .gs-results mark { background: transparent; color: #ff1450; font-weight: 600; }

    .gs-no-results {
        padding: 24px 16px; text-align: center;
        font-family: 'Barlow', sans-serif; font-size: 14px; color: #6b5d80;
    }
    .gs-no-results strong { color: #c4b8d6; }
    .gs-no-results small { display: block; margin-top: 6px; font-size: 12px; color: #4a3d60; }

    /* ═══ MOBILE SEARCH TRIGGER ═══ */
    .gta-msearch {
        display: flex;
        animation: msearch-pulse 3s ease-in-out 1s infinite;
    }
    @keyframes msearch-pulse {
        0%, 100% { color: rgba(255, 255, 255, 0.6); background: none; }
        50% { color: #ff1450; background: rgba(255, 20, 80, 0.12); }
    }
    .gta-msearch:hover { animation: none; }
    @media (min-width: 1024px) { .gta-msearch { display: none; } }


    /* ═══ MOBILE MENU ═══ */
    /* ═══ MOBILE MENU ═══ */
    .gta-mobile-menu {
        position: fixed; inset: 0; z-index: 10000;
        background: rgba(8, 5, 18, 0.92);
        backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
        overflow-y: auto; -webkit-overflow-scrolling: touch;
        display: flex; flex-direction: column;
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .gta-mobile-menu.active { transform: translateX(0); }

    .gta-mm-top {
        display: flex; align-items: center; justify-content: space-between;
        padding: 12px 16px; flex-shrink: 0;
        border-bottom: 1px solid rgba(255, 20, 80, 0.1);
    }
    .gta-mm-logo { display: flex; align-items: center; text-decoration: none; }
    .gta-mm-logo img { height: 36px; width: auto; image-rendering: auto; }
    .gta-mm-logo .gta-text-logo-gta, .gta-mm-logo .gta-text-logo-intel { font-size: 22px; }
    .gta-mm-logo .gta-text-logo-six { font-size: 24px; margin: 0 2px; }
    .gta-mm-close {
        width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
        background: none; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px;
        color: rgba(255, 255, 255, 0.6); cursor: pointer; transition: all 0.15s; flex-shrink: 0;
    }
    .gta-mm-close:hover { color: #fff; border-color: rgba(255, 20, 80, 0.3); background: rgba(255, 20, 80, 0.06); }
    .gta-mm-close svg { width: 22px; height: 22px; }

    .gta-mm-search {
        margin: 12px 16px; padding: 12px 14px; display: flex; align-items: center; gap: 10px;
        background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px; cursor: pointer; transition: all 0.15s;
    }
    .gta-mm-search:hover { border-color: rgba(255, 20, 80, 0.25); background: rgba(255, 20, 80, 0.04); }
    .gta-mm-search svg { width: 18px; height: 18px; color: rgba(255, 255, 255, 0.35); flex-shrink: 0; }
    .gta-mm-search span { font-family: 'Barlow', sans-serif; font-size: 14px; color: rgba(255, 255, 255, 0.3); }

    .gta-mm-body { flex: 1; padding: 8px 16px 0; }

    .gta-mm-section {
        font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 700;
        letter-spacing: 3px; text-transform: uppercase; color: #ff1450;
        padding: 20px 0 8px; display: flex; align-items: center; gap: 8px;
    }
    .gta-mm-section::before { content: ''; width: 12px; height: 2px; background: #ff1450; border-radius: 1px; }
    .gta-mm-section:first-child { padding-top: 8px; }

    .gta-mm-separator { height: 1px; background: rgba(255, 255, 255, 0.05); margin: 4px 0; }

    .gta-mm-link {
        display: flex; align-items: center; gap: 14px;
        min-height: 52px; padding: 0 8px;
        border-radius: 12px; text-decoration: none;
        transition: background 0.12s;
    }
    .gta-mm-link:active { background: rgba(255, 20, 80, 0.06); }

    .gta-mm-icon {
        width: 36px; height: 36px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .gta-mm-icon svg { width: 18px; height: 18px; }

    .gta-mm-label {
        font-family: 'Barlow Condensed', sans-serif; font-size: 15px; font-weight: 600;
        letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.7);
        transition: color 0.15s; flex: 1;
    }
    .gta-mm-link:active .gta-mm-label { color: #fff; }

    .gta-mm-count {
        font-family: 'Barlow', sans-serif; font-size: 12px; color: rgba(255, 255, 255, 0.25);
        flex-shrink: 0;
    }

    .gta-mm-footer {
        margin-top: auto; padding: 20px 16px; flex-shrink: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .gta-mm-disclaimer { font-family: 'Barlow', sans-serif; font-size: 11px; color: rgba(255, 255, 255, 0.15); line-height: 1.5; margin: 0; }



    /* Popular items — 2 column grid */
    .gs-popular-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
        padding: 4px 8px 8px;
    }
    .gs-popular-item {
        display: flex; align-items: center; gap: 10px;
        padding: 8px 10px; border-radius: 8px;
        text-decoration: none; transition: background 0.15s;
    }
    .gs-popular-item:hover { background: rgba(255, 20, 80, 0.06); }
    .gs-popular-item-img {
        width: 36px; height: 36px; border-radius: 8px; object-fit: cover;
        background: rgba(255, 255, 255, 0.05); flex-shrink: 0;
    }
    .gs-popular-item-info { flex: 1; min-width: 0; }
    .gs-popular-item-name {
        font-family: 'Barlow Condensed', sans-serif; font-size: 13px; font-weight: 600;
        letter-spacing: 0.3px; color: rgba(255, 255, 255, 0.5); transition: color 0.15s;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .gs-popular-item:hover .gs-popular-item-name { color: #fff; }
    .gs-popular-item-cat {
        font-family: 'Barlow', sans-serif; font-size: 11px; color: #4a3d60; margin-top: 1px;
    }

    /* Desktop category chips */
    .gs-cat-chips {
        display: flex; flex-wrap: wrap; gap: 6px; padding: 4px 12px 10px;
    }
    .gs-cat-chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 12px; border-radius: 20px;
        font-family: 'Barlow Condensed', sans-serif; font-size: 12px; font-weight: 600;
        letter-spacing: 0.5px; text-transform: uppercase;
        color: rgba(255, 255, 255, 0.45);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        text-decoration: none; transition: all 0.15s;
    }
    .gs-cat-chip:hover {
        color: #fff; background: rgba(255, 20, 80, 0.08);
        border-color: rgba(255, 20, 80, 0.2);
    }
    .gs-cat-chip svg { width: 14px; height: 14px; }

    @keyframes gta-spin { to { transform: rotate(360deg); } }
</style>


<div x-data="{
    mobileOpen: false,
    toggleMobile() {
        this.mobileOpen = !this.mobileOpen;
        document.body.classList.toggle('mobile-menu-open', this.mobileOpen);
    },
    closeMobile() {
        this.mobileOpen = false;
        document.body.classList.remove('mobile-menu-open');
    }
}" @keydown.escape.window="closeMobile()">
