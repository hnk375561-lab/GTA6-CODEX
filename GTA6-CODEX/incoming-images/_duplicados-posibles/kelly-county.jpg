<script>
    document.querySelectorAll('[data-for-humans]').forEach(function(el) {
        var dateStr = el.getAttribute('data-date');
        if (!dateStr) return;

        var date = new Date(dateStr);
        if (isNaN(date)) return;

        var localDate = new Date(date.getTime() + (date.getTimezoneOffset() * 60000 * -1));

        function timeAgo(date) {
            var now = new Date();
            var seconds = Math.floor((now - date) / 1000);
            var intervals = [
                { label: 'year', seconds: 31536000 },
                { label: 'month', seconds: 2592000 },
                { label: 'day', seconds: 86400 },
                { label: 'hour', seconds: 3600 },
                { label: 'minute', seconds: 60 },
                { label: 'second', seconds: 1 }
            ];
            for (var i = 0; i < intervals.length; i++) {
                var interval = Math.floor(seconds / intervals[i].seconds);
                if (interval >= 1) {
                    return interval + ' ' + intervals[i].label + (interval > 1 ? 's' : '') + ' ago';
                }
            }
            return 'just now';
        }

        el.textContent = timeAgo(localDate);
    });
</script>
        
        
        

    
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var obs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) { e.target.classList.add("visible"); obs.unobserve(e.target); }
            });
        }, { threshold: 0.08, rootMargin: "0px 0px -30px 0px" });
        document.querySelectorAll(".gta-scroll-reveal").forEach(function(el) { obs.observe(el); });
    });
    </script>
    
    <script>
    (function(){
        function timeAgo(ts){
            var d=Math.floor((Date.now()-new Date(ts).getTime())/1000);
            if(d<60)return'just now';
            if(d<3600)return Math.floor(d/60)+'m ago';
            if(d<86400)return Math.floor(d/3600)+'h ago';
            return Math.floor(d/86400)+'d ago';
        }
        function updateTimestamps(){
            document.querySelectorAll('[data-timestamp]').forEach(function(el){
                var ts=el.getAttribute('data-timestamp');
                if(ts)el.textContent=timeAgo(ts);
            });
        }
        updateTimestamps();
        setInterval(updateTimestamps,30000);

        // Live feed polling — updates feed lists on cached pages every 60s
        var feedContainers=document.querySelectorAll('[data-live-feed]');
        if(feedContainers.length){
            function refreshFeeds(){
                feedContainers.forEach(function(container){
                    var type=container.getAttribute('data-feed-type')||'all';
                    var limit=container.getAttribute('data-feed-limit')||'12';
                    var url='/api/feed?type='+type+'&limit='+limit;
                    fetch(url).then(function(r){return r.json()}).then(function(data){
                        if(!data.items||!data.items.length)return;
                        var html='';
                        data.items.forEach(function(a){
                            var ts=a.published_at?timeAgo(a.published_at):'';
                            var target=a.is_external?' target="_blank" rel="noopener"':'';
                            var imgSrc=a.media_url||a.image_url;
                            var xIcon='<svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>';
                            var twBadge='<span class="hp-news-source" style="display:inline-flex;align-items:center;gap:4px;color:#1d9bf0;background:rgba(29,155,240,0.1)">'+xIcon+' Post</span>';
                            var title=a.source_type==='twitter'?(a.excerpt||a.title):a.title;
                            // Detect container type for proper markup
                            if(container.classList.contains('hp-news-list')){
                                var badge=a.source_type==='twitter'?twBadge:'<span class="hp-news-source">'+a.badge+'</span>';
                                var thumb=imgSrc?'<div class="hp-news-thumb"><img src="'+imgSrc+'" alt="" loading="lazy"></div>':'';
                                html+='<a href="'+a.link+'"'+target+' class="hp-news-item">'
                                    +'<div class="hp-news-item-body">'
                                    +'<div class="hp-news-item-meta">'+badge
                                    +'<span class="hp-news-time" data-timestamp="'+(a.published_at||'')+'">'+ts+'</span>'
                                    +'</div>'
                                    +'<div class="hp-news-title">'+title+'</div>'
                                    +'</div>'+thumb+'</a>';
                            }else if(container.classList.contains('hp-mobile-news-list')){
                                var badge=a.source_type==='twitter'?twBadge:'<span class="hp-news-source">'+a.badge+'</span>';
                                var thumb=imgSrc?'<div class="hp-news-thumb"><img src="'+imgSrc+'" alt="" loading="lazy"></div>':'';
                                html+='<a href="'+a.link+'"'+target+' class="hp-news-item">'
                                    +'<div class="hp-news-item-body">'
                                    +'<div class="hp-news-item-meta">'+badge
                                    +'<span class="hp-news-time" data-timestamp="'+(a.published_at||'')+'">'+ts+'</span>'
                                    +'</div>'
                                    +'<div class="hp-news-title">'+title+'</div>'
                                    +'</div>'+thumb+'</a>';
                            }else{
                                // Intel feed page
                                var pinnedBadge=a.is_pinned?'<span class="intel-badge intel-badge--pinned"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg> Pinned</span>':'';
                                var badge=a.source_type==='twitter'?'<span class="intel-badge intel-badge--tw"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg> Post</span>':'<span class="intel-badge '+(a.source_type==='custom'?'intel-badge--custom':'')+'">'+a.badge+'</span>';
                                var readTime=a.read_time?'<span class="intel-readtime">'+a.read_time+' min read</span>':'';
                                var thumb=imgSrc?'<div class="intel-thumb"><img src="'+imgSrc+'" alt="" loading="lazy"></div>':'';
                                html+='<a href="'+a.link+'"'+target+' class="intel-item">'
                                    +'<div class="intel-item-body">'
                                    +'<div class="intel-item-meta">'+pinnedBadge+badge
                                    +'<span class="intel-time" data-timestamp="'+(a.published_at||'')+'">'+ts+'</span>'
                                    +readTime+'</div>'
                                    +'<div class="intel-item-title">'+title+'</div>'
                                    +'</div>'+thumb+'</a>';
                            }
                        });
                        if(html)container.innerHTML=html;
                    }).catch(function(){});
                });
            }
            // Poll every 60s for fresh content
            setInterval(refreshFeeds,60000);
        }
    })();
    </script>
    
    <div id="gi-nl-slideup" class="gi-nl-slideup" aria-label="Newsletter signup" role="dialog" style="display:none;">
    <div class="gi-nl-slideup-glow-orb"></div>
    <div class="gi-nl-slideup-glow-line"></div>
    <button type="button" class="gi-nl-slideup-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
    <div class="gi-nl-slideup-content">
        <div class="gi-nl-slideup-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
        </div>
        <div class="gi-nl-slideup-text">
            <strong>Be First on Launch Day</strong>
            <span>Get the latest news and pre-order alerts — straight to your inbox.</span>
        </div>
    </div>
    <div class="gi-nl-slideup-form-wrap">
        <div wire:snapshot="{&quot;data&quot;:{&quot;email&quot;:null,&quot;error&quot;:null,&quot;success&quot;:null},&quot;memo&quot;:{&quot;id&quot;:&quot;SbUXviPcIDYnV0QuclQd&quot;,&quot;name&quot;:&quot;frontend.newsletter&quot;,&quot;path&quot;:&quot;image\/item\/9ef6c5b4-c3e7-4811-a9db-8d1ff26c0ef6\/original&quot;,&quot;method&quot;:&quot;GET&quot;,&quot;children&quot;:[],&quot;scripts&quot;:[],&quot;assets&quot;:[],&quot;errors&quot;:[],&quot;locale&quot;:&quot;en&quot;},&quot;checksum&quot;:&quot;e4b4296118f4947ccfb2d53a8b7fb10254906477cfcd6f43313151b2fd831a0a&quot;}" wire:effects="[]" wire:id="SbUXviPcIDYnV0QuclQd">
            <form class="flex flex-col items-start justify-center gap-6 md:flex-row" method="POST"
            wire:submit.prevent="subscribe">
            <input type="hidden" name="_token" value="EKbfixjRP5Iq8juyhj2qZTatyq61UFcFW2tNXVER" autocomplete="off">            <div class="flex min-w-80 flex-col items-start justify-start gap-1.5">
                <div class="flex h-10 flex-col items-start justify-start gap-1.5 self-stretch">
                    <input
                        class="flex items-center justify-start gap-2 self-stretch rounded-lg border border-neutral-50 bg-transparent px-3 py-2 font-['Inter'] text-base font-normal leading-normal text-white shadow-[0px_1px_2px_0px_rgba(10,13,18,0.05)] ring-0 focus:border-neutral-50 focus:ring-0"
                        name="email" type="email" wire:model="email" required placeholder="Your Email" />
                </div>
            </div>
            <button
                class="flex w-full items-center justify-center gap-1 overflow-hidden rounded-lg border-0 bg-[#c3016e] px-3.5 py-2.5 shadow-[0px_1px_2px_0px_rgba(10,13,18,0.05)] shadow-[inset_0px_-2px_0px_0px_rgba(10,13,18,0.05)] shadow-[inset_0px_0px_0px_1px_rgba(10,13,18,0.18)] md:w-auto"
                type="submit">
                <div class="flex items-center justify-center px-0.5">
                    <div class="font-['Inter'] text-sm font-semibold leading-tight text-white">
                        Subscribe
                    </div>
                </div>
                <div>
                    <svg width="21" height="20" viewBox="0 0 21 20" fill="none"
                        xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M18.417 15.0002L12.8813 10.0002M8.11937 10.0002L2.58369 15.0002M2.16699 5.8335L8.97109 10.5964C9.52207 10.982 9.79756 11.1749 10.0972 11.2496C10.3619 11.3156 10.6387 11.3156 10.9034 11.2496C11.2031 11.1749 11.4786 10.982 12.0296 10.5964L18.8337 5.8335M6.16699 16.6668H14.8337C16.2338 16.6668 16.9339 16.6668 17.4686 16.3943C17.939 16.1547 18.3215 15.7722 18.5612 15.3018C18.8337 14.767 18.8337 14.067 18.8337 12.6668V7.3335C18.8337 5.93336 18.8337 5.2333 18.5612 4.69852C18.3215 4.22811 17.939 3.84566 17.4686 3.60598C16.9339 3.3335 16.2338 3.3335 14.8337 3.3335H6.16699C4.76686 3.3335 4.0668 3.3335 3.53202 3.60598C3.06161 3.84566 2.67916 4.22811 2.43948 4.69852C2.16699 5.2333 2.16699 5.93336 2.16699 7.3335V12.6668C2.16699 14.067 2.16699 14.767 2.43948 15.3018C2.67916 15.7722 3.06161 16.1547 3.53202 16.3943C4.0668 16.6668 4.76686 16.6668 6.16699 16.6668Z"
                            stroke="white" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </button>
        </form>

            </div>    </div>
</div>

<style>
.gi-nl-slideup {
    display: none;
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    z-index: 9999;
    background: rgba(18, 10, 32, 0.7);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 20px;
    padding: 20px;
    transform: translateY(calc(100% + 32px));
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
    opacity: 0;
    box-shadow:
        0 12px 40px rgba(0,0,0,0.45),
        0 0 80px rgba(255,45,120,0.06),
        inset 0 1px 0 rgba(255,255,255,0.04);
    overflow: hidden;
}
.gi-nl-slideup.is-visible {
    transform: translateY(0);
    opacity: 1;
}

.gi-nl-slideup-glow-orb {
    position: absolute;
    top: -20px;
    left: -10px;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(255,45,120,0.1) 0%, transparent 70%);
    pointer-events: none;
}

.gi-nl-slideup-glow-line {
    position: absolute;
    top: -1px;
    left: 15%;
    right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,45,120,0.35), transparent);
    pointer-events: none;
}

.gi-nl-slideup-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(255,255,255,0.05);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    color: #7a6b94;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 1;
}
.gi-nl-slideup-close:hover {
    color: #fff;
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.12);
}

.gi-nl-slideup-content {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    padding-right: 32px;
    position: relative;
}

.gi-nl-slideup-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(255,45,120,0.1);
    border: 1px solid rgba(255,45,120,0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ff2d78;
    box-shadow: 0 0 20px rgba(255,45,120,0.08);
}
.gi-nl-slideup-icon svg {
    width: 18px;
    height: 18px;
}

.gi-nl-slideup-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
}
.gi-nl-slideup-text strong {
    font-family: 'Oswald', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.3px;
}
.gi-nl-slideup-text span {
    font-family: 'Barlow', sans-serif;
    font-size: 13px;
    color: #8a7ba0;
    line-height: 1.3;
}

/* =============================================
   Force Livewire form into compact card layout
   ============================================= */
.gi-nl-slideup-form-wrap,
.gi-nl-slideup-form-wrap > div,
.gi-nl-slideup-form-wrap > div > div {
    width: 100% !important;
    max-width: 100% !important;
}

.gi-nl-slideup-form-wrap form {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    gap: 8px !important;
    align-items: stretch !important;
    padding: 0 !important;
    margin: 0 !important;
}

.gi-nl-slideup-form-wrap form > div:first-child,
.gi-nl-slideup-form-wrap form > div:first-child > div,
.gi-nl-slideup-form-wrap form .min-w-80 {
    flex: 1 !important;
    min-width: 0 !important;
    width: auto !important;
}

.gi-nl-slideup-form-wrap form input[type="email"],
.gi-nl-slideup-form-wrap input {
    width: 100% !important;
    min-width: 0 !important;
    background: rgba(255,255,255,0.04) !important;
    border: 1px solid rgba(255,255,255,0.08) !important;
    border-radius: 12px !important;
    padding: 11px 14px !important;
    font-family: 'Barlow', sans-serif !important;
    font-size: 14px !important;
    color: #fff !important;
    box-shadow: none !important;
    height: auto !important;
    line-height: normal !important;
    transition: border-color 0.2s, box-shadow 0.2s !important;
}
.gi-nl-slideup-form-wrap input:focus {
    border-color: rgba(255,45,120,0.25) !important;
    box-shadow: 0 0 0 3px rgba(255,45,120,0.06) !important;
    --tw-ring-shadow: none !important;
}
.gi-nl-slideup-form-wrap input::placeholder {
    color: #5a4d6e !important;
}

.gi-nl-slideup-form-wrap form button {
    flex-shrink: 0 !important;
    width: auto !important;
    background: linear-gradient(135deg, #ff2d78 0%, #d6225f 100%) !important;
    border: none !important;
    border-radius: 12px !important;
    padding: 11px 16px !important;
    font-family: 'Barlow Condensed', sans-serif !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    color: #fff !important;
    box-shadow: 0 0 16px rgba(255,45,120,0.15) !important;
    transition: transform 0.2s, box-shadow 0.2s !important;
    overflow: hidden !important;
    white-space: nowrap !important;
    gap: 0 !important;
}
.gi-nl-slideup-form-wrap form button:hover {
    transform: translateY(-1px) !important;
    box-shadow: 0 4px 24px rgba(255,45,120,0.3) !important;
}

.gi-nl-slideup-form-wrap form button > div:last-child {
    display: none !important;
}
.gi-nl-slideup-form-wrap form button > div:first-child,
.gi-nl-slideup-form-wrap form button > div:first-child > div {
    padding: 0 !important;
    font-size: 13px !important;
}

/* Success/error messages */
.gi-nl-slideup-form-wrap .text-green-500,
.gi-nl-slideup-form-wrap .text-red-500,
.gi-nl-slideup-form-wrap [class*="green"],
.gi-nl-slideup-form-wrap [class*="red"] {
    position: relative !important;
    width: 100% !important;
    margin-top: 10px !important;
    font-size: 13px !important;
    text-align: center !important;
    border-radius: 10px !important;
    padding: 8px 12px !important;
    left: auto !important;
}
.gi-nl-slideup-form-wrap .text-green-500,
.gi-nl-slideup-form-wrap [class*="green"] {
    background: rgba(74,222,128,0.06) !important;
    border: 1px solid rgba(74,222,128,0.1) !important;
}
.gi-nl-slideup-form-wrap .text-red-500,
.gi-nl-slideup-form-wrap [class*="red"] {
    background: rgba(248,113,113,0.06) !important;
    border: 1px solid rgba(248,113,113,0.1) !important;
}

/* Desktop: card bottom-right */
@media (min-width: 769px) {
    .gi-nl-slideup {
        left: auto;
        right: 24px;
        bottom: 24px;
        max-width: 440px;
    }
}

/* Small mobile: stack */
@media (max-width: 380px) {
    .gi-nl-slideup-form-wrap form {
        flex-direction: column !important;
    }
    .gi-nl-slideup-form-wrap form button {
        width: 100% !important;
        justify-content: center !important;
    }
}
</style>

<script>
(function(){
    var el = document.getElementById('gi-nl-slideup');
    if (!el) return;

    if (document.cookie.indexOf('gi_nl_dismissed=1') !== -1) return;

    var shown = false;
    function checkScroll() {
        if (shown) return;
        var scrollPct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
        if (scrollPct >= 0.5) {
            shown = true;
            el.style.display = 'block';
            el.offsetHeight;
            el.classList.add('is-visible');
            window.removeEventListener('scroll', checkScroll);
        }
    }
    window.addEventListener('scroll', checkScroll, { passive: true });

    function dismiss() {
        el.classList.remove('is-visible');
        setTimeout(function(){ el.style.display = 'none'; }, 400);
        document.cookie = 'gi_nl_dismissed=1;path=/;max-age=604800';
    }
    el.querySelector('.gi-nl-slideup-close').addEventListener('click', dismiss);

    document.addEventListener('livewire:initialized', function() {
        Livewire.on('newsletter-subscribed', function() {
            document.cookie = 'gi_nl_dismissed=1;path=/;max-age=31536000';
            setTimeout(dismiss, 3000);
        });
    });
})();
</script>
    </body>
</html>