<script>
(function(){
    /* ═══ RECENT SEARCHES (localStorage) ═══ */
    var RECENT_KEY = 'gta6_recent_searches';
    var MAX_RECENT = 5;

    function getRecent() {
        try { return JSON.parse(localStorage.getItem(RECENT_KEY)) || []; } catch(e) { return []; }
    }
    function saveRecent(list) {
        try { localStorage.setItem(RECENT_KEY, JSON.stringify(list)); } catch(e) {}
    }
    function addRecent(q) {
        q = q.trim();
        if (!q || q.length < 2) return;
        var list = getRecent().filter(function(s){ return s !== q; });
        list.unshift(q);
        if (list.length > MAX_RECENT) list = list.slice(0, MAX_RECENT);
        saveRecent(list);
    }
    function clearRecent() { saveRecent([]); }

    function renderRecentList(containerId, listId, onSelect) {
        var container = document.getElementById(containerId);
        var list = document.getElementById(listId);
        if (!container || !list) return;
        var recent = getRecent();
        if (recent.length === 0) { container.style.display = 'none'; return; }
        container.style.display = '';
        list.innerHTML = '';
        recent.forEach(function(q){
            var el = document.createElement('div');
            el.className = 'gs-recent-item';
            el.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>' + q.replace(/</g, '&lt;');
            el.addEventListener('click', function(){ onSelect(q); });
            list.appendChild(el);
        });
    }

    /* ═══ HIGHLIGHT HELPER ═══ */
    function highlightResults(container, query) {
        if (!query || !container) return;
        var names = container.querySelectorAll('.gta-search-item-name');
        var escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        var re = new RegExp('(' + escaped + ')', 'gi');
        names.forEach(function(el){
            var original = el.getAttribute('data-name') || el.textContent;
            el.innerHTML = original.replace(re, '<mark>$1</mark>');
        });
    }

    /* ═══ SHARED SEARCH FETCH ═══ */
    function doSearch(q, resultsEl, defaultEl, spinnerEl, callback) {
        if (q.length === 0) {
            resultsEl.innerHTML = '';
            resultsEl.style.display = 'none';
            if (defaultEl) defaultEl.style.display = '';
            spinnerEl.classList.remove('active');
            return;
        }
        if (defaultEl) defaultEl.style.display = 'none';
        resultsEl.style.display = '';
        spinnerEl.classList.add('active');

        fetch('/api/search?per_category=3&q=' + encodeURIComponent(q))
            .then(function(r){ return r.text(); })
            .then(function(html){
                if (html.trim()) {
                    resultsEl.innerHTML = html;
                    highlightResults(resultsEl, q);
                } else {
                    resultsEl.innerHTML = '<div class="gs-no-results">No results for <strong>\u201c' + q.replace(/</g,'&lt;') + '\u201d</strong><small>Try a different search term</small></div>';
                }
                spinnerEl.classList.remove('active');
                if (callback) callback();
            })
            .catch(function(){
                resultsEl.innerHTML = '<div class="gs-no-results">Error loading results</div>';
                spinnerEl.classList.remove('active');
            });
    }

    /* ═══ DESKTOP SEARCH ═══ */
    var trigger = document.getElementById('gs-trigger');
    var wrap = document.getElementById('gs-wrap');
    var expanded = document.getElementById('gs-expanded');
    var input = document.getElementById('gs-input');
    var results = document.getElementById('gs-results');
    var defaultContent = document.getElementById('gs-default-content');
    var spinner = document.getElementById('gs-spinner');
    var closeBtn = document.getElementById('gs-close');
    var timer;

    function openDesktopSearch() {
        if (!trigger) return;
        trigger.style.display = 'none';
        expanded.classList.add('active');
        document.body.classList.add('search-open');
        renderRecentList('gs-recent', 'gs-recent-list', function(q){
            input.value = q;
            handleDesktopInput();
        });
        setTimeout(function(){ input.focus(); }, 50);
    }

    function closeDesktopSearch() {
        if (!expanded) return;
        expanded.classList.remove('active');
        trigger.style.display = '';
        document.body.classList.remove('search-open');
        input.value = '';
        results.innerHTML = '';
        results.style.display = 'none';
        defaultContent.style.display = '';
        spinner.classList.remove('active');
    }

    if (trigger) {
        trigger.addEventListener('click', openDesktopSearch);
        trigger.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDesktopSearch(); } });
    }
    if (closeBtn) closeBtn.addEventListener('click', closeDesktopSearch);

    // Click outside to close
    document.addEventListener('click', function(e){
        if (expanded && expanded.classList.contains('active') && wrap && !wrap.contains(e.target)) {
            closeDesktopSearch();
        }
    });

    // Desktop clear recent
    var gsRecentClear = document.getElementById('gs-recent-clear');
    if (gsRecentClear) gsRecentClear.addEventListener('click', function(){
        clearRecent();
        document.getElementById('gs-recent').style.display = 'none';
    });

    function handleDesktopInput() {
        clearTimeout(timer);
        var q = input.value.trim();
        timer = setTimeout(function(){
            doSearch(q, results, defaultContent, spinner, function(){
                if (q.length >= 2) addRecent(q);
            });
        }, 250);
    }

    if (input) {
        input.addEventListener('input', handleDesktopInput);
        input.addEventListener('keydown', function(e){
            if (e.key === 'Enter' && input.value.trim()) addRecent(input.value.trim());
        });
    }

    /* ═══ MOBILE SEARCH ═══ */
    var msTrigger = document.getElementById('ms-trigger');
    var msOverlay = document.getElementById('ms-overlay');
    var msInput = document.getElementById('ms-input');
    var msClose = document.getElementById('ms-close');
    var msResults = document.getElementById('ms-results');
    var msDefault = document.getElementById('ms-default-content');
    var msSpinner = document.getElementById('ms-spinner');
    var mTimer;

    function openMobileSearch() {
        msOverlay.classList.add('active');
        document.body.classList.add('search-open');
        renderRecentList('ms-recent', 'ms-recent-list', function(q){
            msInput.value = q;
            handleMobileInput();
        });
        setTimeout(function(){ msInput.focus(); }, 100);
    }

    function closeMobileSearch() {
        msOverlay.classList.remove('active');
        document.body.classList.remove('search-open');
        msInput.value = '';
        msResults.innerHTML = '';
        msResults.style.display = 'none';
        msDefault.style.display = '';
        msSpinner.classList.remove('active');
    }

    if (msTrigger) msTrigger.addEventListener('click', openMobileSearch);
    if (msClose) msClose.addEventListener('click', closeMobileSearch);

    // Mobile clear recent
    var msRecentClear = document.getElementById('ms-recent-clear');
    if (msRecentClear) msRecentClear.addEventListener('click', function(){
        clearRecent();
        document.getElementById('ms-recent').style.display = 'none';
    });

    function handleMobileInput() {
        clearTimeout(mTimer);
        var q = msInput.value.trim();
        mTimer = setTimeout(function(){
            doSearch(q, msResults, msDefault, msSpinner, function(){
                if (q.length >= 2) addRecent(q);
            });
        }, 250);
    }

    if (msInput) {
        msInput.addEventListener('input', handleMobileInput);
        msInput.addEventListener('keydown', function(e){
            if (e.key === 'Enter' && msInput.value.trim()) addRecent(msInput.value.trim());
        });
    }

    /* ═══ KEYBOARD SHORTCUTS ═══ */
    document.addEventListener('keydown', function(e){
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            if (window.innerWidth >= 1024) { openDesktopSearch(); } else { openMobileSearch(); }
        }
        if (e.key === 'Escape') {
            if (expanded && expanded.classList.contains('active')) closeDesktopSearch();
            if (msOverlay && msOverlay.classList.contains('active')) closeMobileSearch();
        }
    });

    /* Expose globally */
    window.openGtaSearch = function(){ if (window.innerWidth >= 1024) { openDesktopSearch(); } else { openMobileSearch(); } };
    window.closeGtaSearch = function(){ closeDesktopSearch(); closeMobileSearch(); };
})();
</script>
                    <a href="/countdown" id="countdown-bar" style="
    display: block;
    position: relative;
    width: 100%;
    background: linear-gradient(90deg, #0a0015 0%, rgba(20,5,32,0.95) 15%, rgba(20,5,32,0.95) 85%, #0a0015 100%);
    border-bottom: 1px solid rgba(255, 20, 80, 0.1);
    font-family: 'Inter', system-ui, sans-serif;
    box-sizing: border-box;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: border-color 0.2s;
">
    
    <div class="cb-top-row" style="
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 40px;
        padding: 0 12px;
    ">
        
        <div style="display:flex;align-items:baseline;gap:3px;font-variant-numeric:tabular-nums;">
            <span id="cb-days" class="cb-number" style="font-size:15px;font-weight:800;color:#fff;">--</span>
            <span style="font-size:10px;font-weight:600;color:#ff1450;text-transform:uppercase;">days</span>
            <span style="color:rgba(255,255,255,0.3);font-size:13px;margin:0 1px;">:</span>
            <span id="cb-hours" class="cb-number" style="font-size:15px;font-weight:800;color:#fff;">--</span>
            <span style="font-size:10px;font-weight:600;color:#ff1450;text-transform:uppercase;">hrs</span>
            <span style="color:rgba(255,255,255,0.3);font-size:13px;margin:0 1px;">:</span>
            <span id="cb-mins" class="cb-number" style="font-size:15px;font-weight:800;color:#fff;">--</span>
            <span style="font-size:10px;font-weight:600;color:#ff1450;text-transform:uppercase;">min</span>
            <span style="color:rgba(255,255,255,0.3);font-size:13px;margin:0 1px;">:</span>
            <span id="cb-secs" class="cb-number" style="font-size:15px;font-weight:800;color:#fff;">--</span>
            <span style="font-size:10px;font-weight:600;color:#ff1450;text-transform:uppercase;">sec</span>
        </div>

        
        <div class="cb-cta" style="position:absolute;right:12px;display:flex;align-items:center;gap:4px;padding:4px 6px;border-radius:20px;border:1px solid transparent;background:none;transition:all 0.25s ease;">
            <svg class="cb-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="
                width: 12px;
                height: 12px;
                color: #ff1450;
                animation: cb-arrow-nudge 2s ease-in-out infinite;
            "><path d="M9 18l6-6-6-6"/></svg>
        </div>

    </div>

    
    <div style="width:100%;height:3px;background:rgba(255,255,255,0.05);position:relative;">
        <div id="cb-progress" style="
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #ff1450, #e3007f, #ff1450);
            background-size: 200% 100%;
            animation: cb-shimmer 3s linear infinite;
            transition: width 1s linear;
            box-shadow: 0 0 8px rgba(255, 20, 80, 0.5);
            position: relative;
        ">
            <div class="cb-progress-tip"></div>
        </div>
    </div>
</a>

<style>
    #countdown-bar { transition: background 0.2s ease, border-color 0.2s ease, transform 0.1s ease; }
    #countdown-bar:hover { background: rgba(255, 20, 80, 0.08) !important; border-color: rgba(255, 20, 80, 0.5) !important; }
    #countdown-bar:active { background: rgba(255, 20, 80, 0.12) !important; transform: scale(0.995); }
    #countdown-bar .cb-number { transition: color 0.2s ease; }
    #countdown-bar:hover .cb-number { color: #ff1450 !important; }
    #countdown-bar:hover .cb-cta { border-color: rgba(255,20,80,0.4); background: rgba(255,20,80,0.12); }

    @keyframes cb-arrow-nudge {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(3px); }
    }
    @keyframes cb-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
    .cb-progress-tip {
        position: absolute; right: -3px; top: 50%; transform: translateY(-50%);
        width: 6px; height: 6px; border-radius: 50%;
        background: rgba(255, 20, 80, 0.9);
        box-shadow: 0 0 4px 1px rgba(255, 20, 80, 0.4), 0 0 10px 3px rgba(255, 20, 80, 0.15);
        animation: cb-tip-pulse 3s ease-in-out infinite;
    }
    @keyframes cb-tip-pulse {
        0%, 100% { opacity: 0.7; box-shadow: 0 0 4px 1px rgba(255,20,80,0.4), 0 0 10px 3px rgba(255,20,80,0.15); }
        50% { opacity: 1; box-shadow: 0 0 6px 2px rgba(255,20,80,0.5), 0 0 14px 4px rgba(255,20,80,0.25); }
    }
    /* Mobile: larger tap target */
    .cb-top-row { height: 48px !important; }

    @media (min-width: 768px) {
        .cb-top-row { height: 40px !important; }
    }
</style>

<script>
(function() {
    var startDate = new Date("2023-12-04T02:00:00").getTime();
    var endDate = new Date("2026-11-19T00:00:00").getTime();
    var totalDuration = endDate - startDate;
    var d = document.getElementById('cb-days'),
        h = document.getElementById('cb-hours'),
        m = document.getElementById('cb-mins'),
        s = document.getElementById('cb-secs'),
        bar = document.getElementById('cb-progress');

    function pad(n) { return n < 10 ? '0' + n : n; }

    function tick() {
        var now = Date.now();
        var dist = endDate - now;
        var elapsed = now - startDate;
        var percentage = Math.min(100, Math.max(0, (elapsed / totalDuration) * 100));

        bar.style.width = percentage + '%';

        if (dist <= 0) { d.textContent = '00'; h.textContent = '00'; m.textContent = '00'; s.textContent = '00'; bar.style.width = '100%'; return; }
        d.textContent = pad(Math.floor(dist / 86400000));
        h.textContent = pad(Math.floor((dist % 86400000) / 3600000));
        m.textContent = pad(Math.floor((dist % 3600000) / 60000));
        s.textContent = pad(Math.floor((dist % 60000) / 1000));
    }

    tick();
    setInterval(tick, 1000);
})();
</script>
        
