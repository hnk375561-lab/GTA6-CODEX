        <style>
            /* Prevent horizontal overflow on all viewports */
            html { max-width: 100%; overflow-x: clip; }
            body { max-width: 100vw; overflow-x: hidden; }

            @font-face {
                font-display: swap;
                font-family: 'Inter';
                font-style: normal;
                font-weight: 400;
                src: url('/fonts/inter-v20-latin-regular.woff2') format('woff2');
