@@ -0,0 +1,154 @@
+/* CinematicScroll.css
+   Importar una sola vez, por ejemplo desde src/app/layout.tsx:
+   import '@/styles/cinematic-scroll.css'
+*/
+
+.cs-root {
+  --cs-bg: #090b10;
+  --cs-bg-2: #0e1420;
+  --cs-ink: #f3f0e8;
+  --cs-ink-dim: rgba(243, 240, 232, 0.6);
+  --cs-amber: #e8a33d;
+  --cs-magenta: #ff3d7f;
+  --cs-teal: #2dd9c4;
+  --cs-line: rgba(243, 240, 232, 0.14);
+  position: relative;
+  background: var(--cs-bg);
+  color: var(--cs-ink);
+  font-family: var(--font-sans);
+  overflow-x: clip;
+}
+.cs-root *,
+.cs-root *::before,
+.cs-root *::after { box-sizing: border-box; }
+
+.cs-progress {
+  position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 80;
+  background: linear-gradient(90deg, var(--cs-magenta), var(--cs-amber), var(--cs-teal));
+  transform-origin: left; transform: scaleX(0); will-change: transform;
+}
+
+.cs-scroll-space { position: relative; }
+.cs-viewport { position: fixed; inset: 0; overflow: hidden; }
+.cs-track { will-change: transform; }
+
+.cs-eyebrow {
+  font-family: var(--font-mono); font-size: 11px; letter-spacing: .22em;
+  text-transform: uppercase; color: var(--cs-amber);
+}
+.cs-root h1, .cs-root h2, .cs-root h3 {
+  font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
+  line-height: .92; margin: 0;
+}
+
+.cs-rail {
+  position: fixed; right: 22px; top: 50%; transform: translateY(-50%);
+  display: flex; flex-direction: column; gap: 14px; z-index: 50;
+}
+.cs-rail-dot {
+  width: 8px; height: 8px; border-radius: 50%; border: 1px solid var(--cs-line);
+  background: transparent; cursor: pointer; padding: 0; transition: all .3s;
+}
+.cs-rail-dot.active { background: var(--cs-amber); border-color: var(--cs-amber); width: 8px; height: 22px; border-radius: 4px; }
+
+.cs-cursor {
+  position: fixed; top: 0; left: 0; width: 8px; height: 8px; border-radius: 50%;
+  background: var(--cs-amber); pointer-events: none; z-index: 70; mix-blend-mode: difference;
+  transform: translate(-50%, -50%); will-change: transform;
+}
+
+.cs-counter {
+  position: fixed; left: 22px; bottom: 22px; z-index: 50;
+  font-family: var(--font-mono); font-size: 11px; letter-spacing: .15em;
+  color: var(--cs-ink-dim); display: flex; align-items: center; gap: 8px;
+}
+.cs-counter b { color: var(--cs-ink); font-size: 14px; }
+
+.cs-section {
+  position: relative; min-height: 100vh; display: flex; align-items: center;
+  padding: 0 min(8vw, 120px); border-top: 1px solid var(--cs-line);
+}
+
+/* hero */
+.cs-hero {
+  border-top: none; justify-content: center; text-align: center; overflow: hidden;
+  background:
+    radial-gradient(ellipse 80% 60% at 50% 20%, rgba(255,61,127,0.14), transparent 60%),
+    radial-gradient(ellipse 70% 50% at 50% 85%, rgba(45,217,196,0.10), transparent 60%),
+    var(--cs-bg);
+}
+.cs-hero-glow { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 0%, var(--cs-bg) 92%); z-index: 2; pointer-events: none; }
+.cs-shard-field { position: absolute; inset: 0; z-index: 0; }
+.cs-word-shard {
+  position: absolute; top: 50%; left: 50%; will-change: transform, opacity;
+  font-family: var(--font-mono); font-weight: 500; letter-spacing: .08em;
+  text-transform: uppercase; white-space: nowrap; padding: 6px 12px; border: 1px solid;
+  border-radius: 3px; background: rgba(9,11,16,0.6);
+}
+.cs-wordmark { position: relative; z-index: 3; }
+.cs-wordmark h1 { font-size: clamp(56px, 11vw, 168px); color: var(--cs-ink); text-shadow: 0 0 60px rgba(0,0,0,.5); }
+.cs-sub { font-family: var(--font-display); font-size: clamp(20px, 3vw, 40px); color: var(--cs-magenta); text-transform: uppercase; margin-top: -6px; }
+.cs-hero-meta { position: absolute; bottom: 48px; left: 0; right: 0; display: flex; justify-content: space-between; align-items: flex-end; padding: 0 min(8vw, 120px); z-index: 3; }
+.cs-scroll-cue { display: flex; flex-direction: column; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--cs-ink-dim); }
+.cs-scroll-line { width: 1px; height: 40px; background: linear-gradient(var(--cs-ink-dim), transparent); position: relative; overflow: hidden; }
+.cs-scroll-line::after { content: ''; position: absolute; top: -40px; left: 0; width: 100%; height: 40px; background: var(--cs-amber); animation: csCueDrop 1.8s ease-in-out infinite; }
+@keyframes csCueDrop { 0% { top: -40px; } 100% { top: 40px; } }
+
+/* reveal / dossier */
+.cs-reveal { background: var(--cs-bg-2); gap: 60px; }
+.cs-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: center; width: 100%; }
+.cs-reveal h2 { font-size: clamp(32px, 4.2vw, 64px); }
+.cs-reveal p { color: var(--cs-ink-dim); font-size: 16px; line-height: 1.6; max-width: 46ch; margin-top: 18px; }
+.cs-badges { display: flex; gap: 18px; margin-top: 28px; font-family: var(--font-mono); font-size: 13px; flex-wrap: wrap; }
+.cs-badges div { padding: 10px 16px; border: 1px solid var(--cs-line); border-radius: 4px; }
+.cs-dossier { border: 1px solid var(--cs-line); border-radius: 6px; padding: 28px; font-family: var(--font-mono); font-size: 13px; line-height: 2; background: linear-gradient(160deg, rgba(255,61,127,.06), rgba(45,217,196,.05)); }
+.cs-row { display: flex; justify-content: space-between; border-bottom: 1px dashed var(--cs-line); padding: 6px 0; }
+.cs-row span:first-child { color: var(--cs-ink-dim); }
+
+/* reveal-on-scroll (activado por IntersectionObserver a nivel de módulo, ver nota abajo) */
+.cs-reveal-el { opacity: 0; transform: translateY(28px); transition: opacity .8s cubic-bezier(.16,.84,.44,1), transform .8s cubic-bezier(.16,.84,.44,1); }
+.cs-reveal-el.cs-in { opacity: 1; transform: translateY(0); }
+.cs-reveal-el[data-delay="1"] { transition-delay: .05s; }
+.cs-reveal-el[data-delay="2"] { transition-delay: .15s; }
+.cs-reveal-el[data-delay="3"] { transition-delay: .25s; }
+
+/* ticker */
+.cs-ticker { min-height: auto; padding: 0; overflow: hidden; border-top: 1px solid var(--cs-line); border-bottom: 1px solid var(--cs-line); background: var(--cs-bg-2); }
+.cs-ticker-track { display: flex; white-space: nowrap; will-change: transform; padding: 22px 0; }
+.cs-ticker-item { font-family: var(--font-display); font-size: clamp(22px, 3vw, 40px); text-transform: uppercase; letter-spacing: .02em; padding: 0 36px; display: flex; align-items: center; gap: 36px; color: var(--cs-ink-dim); }
+.cs-ticker-item:nth-child(odd) { color: var(--cs-ink); }
+.cs-ticker-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cs-amber); }
+
+/* zonas */
+.cs-zones { flex-direction: column; align-items: flex-start; gap: 36px; padding-top: 120px; padding-bottom: 120px; }
+.cs-zones h2 { font-size: clamp(28px, 3.4vw, 48px); }
+.cs-zone-row { display: flex; gap: 24px; width: 100%; flex-wrap: wrap; }
+.cs-zone-card { flex: 1; min-width: 220px; aspect-ratio: 3/4; border-radius: 6px; position: relative; overflow: hidden; border: 1px solid var(--cs-line); background: var(--cs-bg-2); will-change: transform; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; }
+.cs-zone-card:nth-child(1) { background: linear-gradient(160deg, rgba(255,61,127,.16), transparent 70%); }
+.cs-zone-card:nth-child(2) { background: linear-gradient(160deg, rgba(232,163,61,.16), transparent 70%); }
+.cs-zone-card:nth-child(3) { background: linear-gradient(160deg, rgba(45,217,196,.16), transparent 70%); }
+.cs-idx { font-family: var(--font-mono); font-size: 12px; color: var(--cs-ink-dim); }
+.cs-zone-card h3 { font-family: var(--font-display); font-size: 28px; text-transform: uppercase; line-height: 1; }
+.cs-tag { font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--cs-amber); }
+
+/* banner */
+.cs-banner { background: var(--cs-bg-2); justify-content: flex-start; }
+.cs-layer { position: absolute; inset: 0; will-change: transform; }
+.cs-layer-1 { background: radial-gradient(ellipse 60% 60% at 20% 40%, rgba(255,61,127,.18), transparent 60%); }
+.cs-layer-2 { background: radial-gradient(ellipse 50% 50% at 80% 60%, rgba(45,217,196,.16), transparent 60%); }
+.cs-banner-content { position: relative; z-index: 2; max-width: 640px; }
+.cs-banner h2 { font-size: clamp(32px, 4.5vw, 68px); }
+.cs-banner p { color: var(--cs-ink-dim); margin-top: 18px; font-size: 16px; line-height: 1.6; }
+
+.cs-footer { border-top: 1px solid var(--cs-line); padding: 60px min(8vw, 120px); display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 12px; color: var(--cs-ink-dim); }
+
+@media (max-width: 820px) {
+  .cs-grid { grid-template-columns: 1fr; gap: 36px; }
+  .cs-zone-row { flex-direction: column; }
+  .cs-rail { display: none; }
+  .cs-cursor { display: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .cs-root * { animation: none !important; transition: none !important; }
+  .cs-reveal-el { opacity: 1 !important; transform: none !important; }
+}
