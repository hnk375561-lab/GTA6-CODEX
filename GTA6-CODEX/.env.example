# URL pública del sitio (usada en sitemap.xml, robots.txt, metadata OG/Twitter).
# En Vercel, configurar con el dominio de producción real, no el de preview.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Si se deja vacío, el script de gtag directamente no se inyecta
# (ver src/app/layout.tsx) — no hace falta un valor placeholder.
NEXT_PUBLIC_GA_ID=

# Publisher ID de Google AdSense (formato ca-pub-0000000000000000).
# Ver public/ads.txt para el resto de la configuración de AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Mercado Libre Affiliate & Creators program (gratis, registrate en
# https://www.mercadolibre.com.ar/afiliados). Sin este tag el botón de
# ML funciona igual pero sin comisión.
NEXT_PUBLIC_MELI_AFFILIATE_TAG=


# Activa el mapa V2 con clustering (LeonidaMapExplorer.tsx / LeonidaMapCanvasV2.tsx).
# Si se deja vacio o en "false", se usa el mapa V1 sin clustering.
# Valores: "true" | "false" (default: false)
NEXT_PUBLIC_MAP_V2=false

# Contraseña de /dashboard (panel de monetización, ver middleware.ts).
# Sin esta variable, /dashboard responde 503 (fail-closed, no fail-open).
# NO usar la misma contraseña que cualquier otra cuenta.
DASHBOARD_PASSWORD=
