{
  "name": "autoficha",
  "version": "0.1.0",
  "description": "AutoFicha - Fichas técnicas de autos y motos con comparador y buscador",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "process-images": "node scripts/process-images.mjs",
    "process-images:apply": "node scripts/process-images.mjs --apply",
    "verify:seo": "node scripts/verify-seo-routes.mjs",
    "verify:content": "node scripts/verify-content-integrity.mjs",
    "verify:min-count": "node scripts/verify-min-entity-count.mjs",
    "audit:evidence": "node scripts/audit-evidence-coverage.mjs",
    "verify:relations": "node scripts/verify-relations-integrity.mjs",
    "verify:relations:selftest": "node scripts/verify-relations-integrity.mjs --self-test",
    "test": "vitest run",
    "verify:tailwind": "node scripts/verify-tailwind-config.mjs",
    "verify:reserved-keys": "node scripts/verify-reserved-entity-keys.mjs",
    "check:unused": "knip",
    "sync:media": "node scripts/media-sync.mjs",
    "generate:manifest-commons": "node scripts/generate-manifest-from-commons.mjs",
    "generate:manifest-commons:write": "node scripts/generate-manifest-from-commons.mjs --write"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/three": "^0.185.4",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.0.0",
    "github-slugger": "^2.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "three": "^0.185.1",
    "typescript": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "postcss": "^8.4.32",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
