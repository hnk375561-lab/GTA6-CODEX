# URL pública del sitio (usada en sitemap.xml, robots.txt, metadata OG/Twitter).
# En Vercel, configurar con el dominio de producción real, no el de preview.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Si se deja vacío, el script de gtag directamente no se inyecta
# (ver src/app/layout.tsx) — no hace falta un valor placeholder.
NEXT_PUBLIC_GA_ID=

# Publisher ID de Google AdSense (formato ca-pub-0000000000000000).
# Ver public/ads.txt para el resto de la configuración de AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Mercado Libre Affiliate & Creators program (gratis, registrate en
# https://www.mercadolibre.com.ar/afiliados). Sin este tag el botón de
# ML funciona igual pero sin comisión.
NEXT_PUBLIC_MELI_AFFILIATE_TAG=


# Activa el mapa V2 con clustering (LeonidaMapExplorer.tsx / LeonidaMapCanvasV2.tsx).
# Si se deja vacio o en "false", se usa el mapa V1 sin clustering.
# Valores: "true" | "false" (default: false)
NEXT_PUBLIC_MAP_V2=false

# Contraseña de /dashboard (panel de monetización, ver middleware.ts).
# Sin esta variable, /dashboard responde 503 (fail-closed, no fail-open).
# NO usar la misma contraseña que cualquier otra cuenta.
DASHBOARD_PASSWORD=

# --- Variables ya usadas en el código pero que faltaban acá (agregadas
# 03/09/2026 junto con la ronda de monetización nueva, para que activar
# cada canal sea completar una variable, no ir a buscar el nombre exacto
# en el componente que la lee) ---

# Número de WhatsApp de contacto (solo dígitos con código de país, ej.
# 5493445XXXXXX). Usado en botones de WhatsApp de todo el sitio.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cafecito ("Invitame un cafecito", ver SupportButton.tsx). Crear cuenta
# en https://cafecito.app y poner el username acá (sin @).
NEXT_PUBLIC_CAFECITO_USERNAME=

# Afiliado de seguro / financiación (ver InsuranceAffiliateButton.tsx y
# FinancingAffiliateButton.tsx en src/components/monetization/). Sin
# acuerdo comercial confirmado todavía — dejar vacío hasta cerrarlo.
NEXT_PUBLIC_SEGURO_AFFILIATE_URL=
NEXT_PUBLIC_FINANCIACION_AFFILIATE_URL=

# Google Forms como backend gratis para LeadQuoteForm.tsx (lead de
# COMPRA). Sin estas variables, el formulario cae a mailto: automáticamente.
NEXT_PUBLIC_LEADS_GFORM_ACTION_URL=
NEXT_PUBLIC_LEADS_GFORM_ENTRY_NOMBRE=
NEXT_PUBLIC_LEADS_GFORM_ENTRY_CONTACTO=
NEXT_PUBLIC_LEADS_GFORM_ENTRY_VEHICULO=
NEXT_PUBLIC_LEADS_GFORM_ENTRY_COMENTARIO=

# Mismo mecanismo que arriba pero para SellVehicleLeadForm.tsx (lead de
# VENTA/tasación) — planilla separada de la de compra a propósito.
NEXT_PUBLIC_VENTA_GFORM_ACTION_URL=
NEXT_PUBLIC_VENTA_GFORM_ENTRY_NOMBRE=
NEXT_PUBLIC_VENTA_GFORM_ENTRY_CONTACTO=
NEXT_PUBLIC_VENTA_GFORM_ENTRY_VEHICULO=
NEXT_PUBLIC_VENTA_GFORM_ENTRY_COMENTARIO=

# --- Canales nuevos de la ronda de 03/09/2026 (ver docs/monetizacion-plan.md) ---

# Access token de PRODUCCIÓN de Mercado Pago (Checkout Pro). Server-side
# únicamente, nunca exponer con prefijo NEXT_PUBLIC_. Habilita DOS
# canales que cobran directo a la persona usuaria: el reporte
# comparativo premium (sección 2.13) y el cartel de venta en PDF
# (sección 2.16). Sin esta variable, ambos endpoints responden 503 en
# vez de romper (fail-closed).
MERCADOPAGO_ACCESS_TOKEN=

# Red de anuncios nativos / "contenido recomendado" (Taboola, Outbrain,
# MGID, RevContent — ver NativeAdUnit.tsx y sección 2.15). Completar con
# la URL del script y el id de contenedor que da la red al aprobar el
# sitio. Sin estas dos variables, el widget no renderiza nada.
NEXT_PUBLIC_NATIVE_ADS_SCRIPT_SRC=
NEXT_PUBLIC_NATIVE_ADS_CONTAINER_ID=
